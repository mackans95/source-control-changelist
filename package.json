{
  "name": "source-control-changelist",
  "displayName": "Changelist",
  "description": "PyCharm-style changelists in the Source Control view: only repositories with changes are shown.",
  "version": "0.0.1",
  "publisher": "marcusgustafsson",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "scm": [
        {
          "type": "webview",
          "id": "changelist.view",
          "name": "Changelist",
          "icon": "$(checklist)"
        }
      ]
    },
    "commands": [
      {
        "command": "changelist.refresh",
        "title": "Refresh",
        "category": "Changelist",
        "icon": "$(refresh)"
      },
      {
        "command": "changelist.viewAsTree",
        "title": "View as Tree",
        "category": "Changelist",
        "icon": "$(list-tree)"
      },
      {
        "command": "changelist.viewAsList",
        "title": "View as List",
        "category": "Changelist",
        "icon": "$(list-flat)"
      },
      {
        "command": "changelist.commit",
        "title": "Commit",
        "category": "Changelist",
        "icon": "$(check)"
      },
      {
        "command": "changelist.stageAll",
        "title": "Stage All Changes",
        "category": "Changelist",
        "icon": "$(add)"
      },
      {
        "command": "changelist.unstageAll",
        "title": "Unstage All Changes",
        "category": "Changelist",
        "icon": "$(remove)"
      },
      {
        "command": "changelist.stage",
        "title": "Stage Changes",
        "category": "Changelist",
        "icon": "$(add)"
      },
      {
        "command": "changelist.unstage",
        "title": "Unstage Changes",
        "category": "Changelist",
        "icon": "$(remove)"
      },
      {
        "command": "changelist.discard",
        "title": "Discard Changes",
        "category": "Changelist",
        "icon": "$(discard)"
      },
      {
        "command": "changelist.discardAll",
        "title": "Discard All Changes",
        "category": "Changelist",
        "icon": "$(discard)"
      },
      {
        "command": "changelist.openChange",
        "title": "Open Changes",
        "category": "Changelist",
        "icon": "$(compare-changes)"
      },
      {
        "command": "changelist.openFile",
        "title": "Open File",
        "category": "Changelist",
        "icon": "$(go-to-file)"
      },
      {
        "command": "changelist.collapseAll",
        "title": "Collapse All",
        "category": "Changelist",
        "icon": "$(collapse-all)"
      },
      {
        "command": "changelist.expandAll",
        "title": "Expand All",
        "category": "Changelist",
        "icon": "$(expand-all)"
      },
      {
        "command": "changelist.sync",
        "title": "Sync Changes",
        "category": "Changelist",
        "icon": "$(sync)"
      },
      {
        "command": "changelist.publish",
        "title": "Publish Branch",
        "category": "Changelist",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "changelist.pull",
        "title": "Pull",
        "category": "Changelist",
        "icon": "$(arrow-down)"
      },
      {
        "command": "changelist.push",
        "title": "Push",
        "category": "Changelist",
        "icon": "$(arrow-up)"
      },
      {
        "command": "changelist.checkout",
        "title": "Switch Branch...",
        "category": "Changelist",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "changelist.viewAsTree",
          "when": "view == changelist.view && config.changelist.viewMode == list",
          "group": "navigation@1"
        },
        {
          "command": "changelist.viewAsList",
          "when": "view == changelist.view && config.changelist.viewMode == tree",
          "group": "navigation@1"
        },
        {
          "command": "changelist.refresh",
          "when": "view == changelist.view",
          "group": "navigation@2"
        },
        {
          "command": "changelist.collapseAll",
          "when": "view == changelist.view && !changelist.allCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "changelist.expandAll",
          "when": "view == changelist.view && changelist.allCollapsed",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "changelist.commit",
          "when": "false"
        },
        {
          "command": "changelist.stageAll",
          "when": "false"
        },
        {
          "command": "changelist.unstageAll",
          "when": "false"
        },
        {
          "command": "changelist.stage",
          "when": "false"
        },
        {
          "command": "changelist.unstage",
          "when": "false"
        },
        {
          "command": "changelist.discard",
          "when": "false"
        },
        {
          "command": "changelist.discardAll",
          "when": "false"
        },
        {
          "command": "changelist.openChange",
          "when": "false"
        },
        {
          "command": "changelist.openFile",
          "when": "false"
        },
        {
          "command": "changelist.sync",
          "when": "false"
        },
        {
          "command": "changelist.publish",
          "when": "false"
        },
        {
          "command": "changelist.pull",
          "when": "false"
        },
        {
          "command": "changelist.push",
          "when": "false"
        },
        {
          "command": "changelist.checkout",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Changelist",
      "properties": {
        "changelist.viewMode": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "enumDescriptions": [
            "Show changes as a flat list, with the folder next to each file.",
            "Show changes as a folder tree."
          ],
          "default": "list",
          "description": "Controls whether changes are shown as a list or as a tree."
        }
      }
    }
  },
  "scripts": {
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build.ts",
    "watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build.ts --watch",
    "typecheck": "tsc -p . && tsc -p src/webview && tsc -p scripts",
    "vscode:prepublish": "npm run build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.82.0",
    "@vscode/codicons": "0.0.46-24",
    "esbuild": "0.28.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  }
}
