{
  "version": "2.0.0",
  "tasks": [
    {
      // Rebuilds dist/ on every change; launch.json starts it before a debug session.
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "never" },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^✘ (.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    },
    {
      // Stops the watch task when the debug window closes; launch.json runs it as postDebugTask.
      // The input runs VS Code's Terminate Task for "watch". The command returns nothing, so the input
      // stays as written, and node gets it as an argument it ignores, without a shell to read it.
      // An extension debug session ends in two parts, and each runs postDebugTask. The second run
      // would otherwise ask which running "stop watch" to end, with an empty list, so it's dropped.
      "label": "stop watch",
      "type": "process",
      "command": "node",
      "args": ["-e", "", "${input:terminateWatch}"],
      "presentation": { "reveal": "never" },
      "problemMatcher": [],
      "runOptions": { "instancePolicy": "silent" }
    },
    {
      // Makes the fake repositories if they aren't there yet, then starts the watch task. launch.json's
      // fake repositories configuration runs it before a debug session.
      "label": "fake repos and watch",
      "dependsOrder": "sequence",
      "dependsOn": ["fake repos", "watch"],
      "problemMatcher": []
    },
    {
      // Makes the fake repositories (scripts/fakeRepos.ts) when they aren't there yet. A reload of the
      // test window runs it again, so it leaves them alone; `npm run fake-repos` starts over.
      "label": "fake repos",
      "type": "shell",
      "command": "npm run fake-repos -- --if-missing",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateWatch",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "watch"
    }
  ]
}
