{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "watch",
      "postDebugTask": "stop watch",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/.."]
    },
    {
      // Same, but with your installed extensions disabled so the Debug Console only shows
      // output from this extension and VS Code's built-ins.
      "name": "Run Extension (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "watch",
      "postDebugTask": "stop watch",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "args": ["--disable-extensions", "--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/.."]
    },
    {
      // Same as Run Extension, but opens fresh fake repositories (scripts/fakeRepos.ts), one in every
      // state the view shows, instead of the folder this project is in.
      "name": "Run Extension (fake repositories)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "fake repos and watch",
      "postDebugTask": "stop watch",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/.fake-repos/repos"],
      // Git stops looking for a repository at .fake-repos/, so this project's own repository, which
      // .fake-repos/ is inside, isn't opened as the parent of the repos/ folder.
      "env": { "GIT_CEILING_DIRECTORIES": "${workspaceFolder}/.fake-repos" }
    },
    {
      // Same fake repositories, but opened as a workspace with each repository as its own folder, in an
      // order that isn't alphabetical, like a .code-workspace file's folders.
      "name": "Run Extension (fake workspace)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "fake repos and watch",
      "postDebugTask": "stop watch",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/.fake-repos/fake.code-workspace"],
      // Git stops looking for a repository at .fake-repos/, so this project's own repository, which
      // .fake-repos/ is inside, isn't opened as the parent of the repos/ folder.
      "env": { "GIT_CEILING_DIRECTORIES": "${workspaceFolder}/.fake-repos" }
    }
  ]
}
